{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.s-n-sales.local/url-allowlist.v1.json",
  "title": "URL allowlist v1",
  "description": "Allowlist host có nguồn chính thức và ngày kiểm chứng; rỗng nghĩa là fail-closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "max_redirects", "hosts"],
  "properties": {
    "schema_version": {
      "const": "url-allowlist.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "max_redirects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "hosts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "purpose", "reference", "verified_on"],
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "purpose": {
            "enum": ["affiliate", "product", "evidence"]
          },
          "reference": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}

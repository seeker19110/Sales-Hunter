{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.s-n-sales.local/approval-record.v1.json",
  "title": "Approval record v1",
  "description": "Quyết định duyệt/từ chối một bản nháp. Gắn chặt với draft_sha256; sửa nội dung làm approval cũ mất hiệu lực.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "publication_id",
    "draft_sha256",
    "status",
    "decided_by",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "approval-record.v1"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "publication_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["approved", "rejected"]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "policy_version": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100,
      "description": "Phiên bản policy/approval checklist được áp dụng khi quyết định."
    }
  }
}

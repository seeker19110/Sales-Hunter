# Install outside git as /etc/sales-hunter/pilot.env, root:sales-hunter, mode 0640.
# No Learning credentials or database paths. Missing databases fail startup.
SALES_PUBLIC_ORIGIN=https://sales-staging.donghanhcungban.org
SALES_PILOT_DB_PATH=/var/lib/sales-hunter-pilot/operator.db
SALES_OPERATOR_ACTOR=operator
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
SALES_OPERATOR_TOKEN=
